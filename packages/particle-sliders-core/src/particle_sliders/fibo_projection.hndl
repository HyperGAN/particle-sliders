features = linear(value, 8, bias=False, name="down")
route = linear(features, 16, name="router0")
route = leaky_relu(route, 0.2)
route = linear(route, 16, name="router2")
route = leaky_relu(route, 0.2)
route = linear(route, 16, name="router4")
route = leaky_relu(route, 0.2)
route = linear(route, 4, name="router6")
keys = transpose(particles, 1, 2)
weights = matmul(route, keys)
weights = scale(weights, 0.5)
weights = softmax(weights, -1)
selected = matmul(weights, particles)
joined = concat(features, selected, axis=2)
joined = linear(joined, 48, name="bridge0")
joined = leaky_relu(joined, 0.2)
joined = linear(joined, 48, name="bridge2")
joined = leaky_relu(joined, 0.2)
joined = linear(joined, 48, name="bridge4")
joined = leaky_relu(joined, 0.2)
joined = linear(joined, 8, name="bridge6")
linear(joined, $output_width, bias=False, name="up")
